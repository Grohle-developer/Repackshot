# Repackshot hygiene: this is a CLEAN-ROOM project.
# Nothing derived from KeyShot's binaries may ever enter this repo.
# These patterns are a second line of defense in case someone slips.

# KeyShot installers / binaries / packages (any platform, any name)
*[Kk]ey*[Ss]hot*
*.msi
*.pkg
*.dmg
*.run
*.AppImage

# Disassembly / decompilation output and RE tool projects
*.asm
*.dump
*.decompiled.*
ghidra-projects/
*.gpr
hopper/
ida/
binary-ninja/

# Render caches and large local assets (keep the repo lean)
*.exr
*.hdr.bak
render-output/

# Build / tooling artifacts
node_modules/
dist/
out/
.vite/
*.local
.DS_Store
engine/target/
public/engine/
public/vendor/
public/licences/
