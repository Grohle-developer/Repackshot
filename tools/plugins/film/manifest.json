      "aux": {
        "en": "Grain is sized in micrometres on the negative: a smaller format shows larger grain at the same pixels.",
        "es": "El grano se mide en micras sobre el negativo: un formato menor enseña el grano más grande con los mismos píxeles."
      }
    },
    {
      "key": "exposure",
      "label": {
        "en": "Film exposure (push and pull)",
        "es": "Exposición de la película (forzado)"
      },
      "kind": "slider",
      "group": "film",
      "min": -3,
      "max": 3,
      "step": 0.01,
      "default": 0,
      "unit": "EV",
      "aux": {
        "en": "Stops the film is given: above nought over-exposed or pushed, below it pulled.",
        "es": "Pasos que recibe la película: por encima de cero sobreexpuesta o forzada, por debajo subexpuesta."
      }
    },
    {
      "key": "colour",
      "label": {
        "en": "Colour",
        "es": "Color"
      },
      "kind": "toggle",
      "group": "colour",
      "default": true,
      "aux": {
        "en": "Off: the film’s colour is not heard, only its grain and its halation.",
        "es": "Apagado: no se oye el color de la película, solo su grano y su halación."
      }
    },
    {
      "key": "model",
      "label": {
        "en": "Model",
        "es": "Modelo"
