{
  "abi": 1,
  "id": "aintfilm-film",
  "name": {
    "en": "aintfilm · film simulation",
    "es": "aintfilm · simulación de película"
  },
  "version": "__VERSION__",
  "publisher": "Grohle",
  "licence": {
    "kind": "closed",
    "label": {
      "en": "Closed licence",
      "es": "Licencia cerrada"
    },
    "file": "LICENCE.txt"
  },
  "homepage": "https://aintfilm.app",
  "summary": {
    "en": "The film engine of aintfilm, the photo editing and film simulation app by the same developer: film stocks, grain sized on the negative, halation, diffusion filters and the print or the scan, over a finished render.",
    "es": "El motor de película de aintfilm, la app de edición de fotos y simulación de película del mismo desarrollador: películas, grano medido sobre el negativo, halación, filtros de difusión y la copia o el escaneo, sobre un render terminado."
  },
  "notice": {
    "en": "A preview of aintfilm, a photo editing and film simulation app by the same developer, in development.",
    "es": "Adelanto de una app de edición de fotos y simulación de película del mismo desarrollador, en desarrollo."
  },
  "logo": "logo.svg",
  "slots": [
    "render.plugins"
  ],
  "entry": "plugin.js",
  "wasm": {
    "file": "module.wasm",
    "noImports": true
  },
  "notices": "NOTICES.txt",
